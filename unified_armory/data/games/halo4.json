    "format": "gltf",
    "max_weights": 4,
    "data_dir": "objects\\characters\\storm_masterchief_armory",
    "model_file": "render\\storm_masterchief_armory.glb",
    "render_model_tag": "objects\\characters\\storm_masterchief_armory\\storm_masterchief_armory.render_model",
    "shader_dir": "objects\\characters\\storm_masterchief_armory\\shaders",
    "shader_ext": "material",
    "shader_template": "objects\\characters\\storm_masterchief\\shaders\\masterchief_armor.material",
    "shader_bitmap_params": {
      "base": "color_map",
      "normal": "normal_map",
      "specular": "specular_map",
      "change_color": "color_mask_map"
    },
    "bitmap_dir": "objects\\characters\\storm_masterchief_armory\\bitmaps",
    "role_suffix": {
      "normal": "_normal"
    },
    "import_commands": [
      "\"%BLENDER%\" --background --python \"{tools}\\blender\\gltf_to_fbx.py\" -- \"{data_root}\\{data_dir}\\render\\storm_masterchief_armory.glb\" \"{data_root}\\{data_dir}\\render\\storm_masterchief_armory.fbx\"",
      "tool.exe bitmaps \"{bitmap_dir}\"",
      "tool.exe fbx-to-gr2 \"{data_root}\\{data_dir}\\render\\storm_masterchief_armory.fbx\" \"{data_root}\\{data_dir}\\render\\storm_masterchief_armory.json\" \"{data_root}\\{data_dir}\\render\\storm_masterchief_armory.gr2\"",
      "tool.exe import \"{data_dir}\""
    ],
    "hookup": [
      {
        "op": "set_reference",
        "tag": "objects\\characters\\storm_masterchief\\storm_masterchief.model",
        "field": "render model",
        "value": "{render_model_tag}"
      }
    ],
    "change_colors": {
      "bipeds": [
        "objects\\characters\\storm_masterchief\\storm_masterchief.biped"
      ],
      "channels": {
        "primary": 0,
        "secondary": 1
      }
    },
    "scenarios": [
      "levels\\solo\\m10_crash\\m10_crash",
      "levels\\solo\\m020\\m020",
      "levels\\solo\\m30_cryptum\\m30_cryptum",
      "levels\\solo\\m40_invasion\\m40_invasion",
      "levels\\solo\\m60_rescue\\m60_rescue",
      "levels\\solo\\m70_liftoff\\m70_liftoff",
      "levels\\solo\\m80_delta\\m80_delta",
      "levels\\solo\\m90_sacrifice\\m90_sacrifice"
    ],
    "build_command": "tool.exe build-cache-file {scenario}",
    "script": {
      "player": "(player0)",
      "file": "unified_armory.hsc",
      "_verify": "The mission script is attached through the scenario's script source files and compiled by tool when the level is built."
    }
  },
  "_verify": "Halo 4 is the least certain route. Its kit imports GR2, made from FBX by `tool fbx-to-gr2`, which also wants a JSON sidecar describing the model. That sidecar isn't generated here; the Foundry Blender add-on can produce the FBX+JSON pair. The tag paths and region names are best guesses."
}
