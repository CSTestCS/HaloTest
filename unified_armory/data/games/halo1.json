    "format": "jms",
    "jms_version": 8200,
    "max_weights": 2,
    "data_dir": "characters\\cyborg_armory",
    "model_file": "models\\base.jms",
    "render_model_tag": "characters\\cyborg_armory\\cyborg_armory.gbxmodel",
    "shader_dir": "characters\\cyborg_armory\\shaders",
    "shader_ext": "shader_model",
    "shader_template": "characters\\cyborg\\shaders\\cyborg.shader_model",
    "shader_bitmap_params": {
      "base": "base map",
      "change_color": "multipurpose map"
    },
    "bitmap_dir": "characters\\cyborg_armory\\bitmaps",
    "role_suffix": {},
    "import_commands": [
      "tool.exe bitmaps \"{bitmap_dir}\"",
      "tool.exe model \"{data_dir}\""
    ],
    "hookup": [
      {
        "op": "set_reference",
        "tag": "characters\\cyborg\\cyborg.biped",
        "field": "model",
        "value": "{render_model_tag}"
      }
    ],
    "change_colors": {
      "bipeds": [
        "characters\\cyborg\\cyborg.biped"
      ],
      "channels": {
        "primary": 0
      }
    },
    "scenarios": [
      "levels\\a10\\a10",
      "levels\\a30\\a30",
      "levels\\a50\\a50",
      "levels\\b30\\b30",
      "levels\\b40\\b40",
      "levels\\c10\\c10",
      "levels\\c20\\c20",
      "levels\\c40\\c40",
      "levels\\d20\\d20",
      "levels\\d40\\d40"
    ],
    "build_command": "tool.exe build-cache-file {scenario}"
  },
  "_verify": "Halo CE has no ManagedBlam: the shader and biped edits in plan.json are done by hand in Guerilla (the install script stops and lists them)."
}
