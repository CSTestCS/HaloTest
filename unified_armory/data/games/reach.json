    "data_dir": "objects\\characters\\spartans_armory",
    "model_file": "render\\spartans_armory.jms",
    "render_model_tag": "objects\\characters\\spartans_armory\\spartans_armory.render_model",
    "shader_dir": "objects\\characters\\spartans_armory\\shaders",
    "shader_ext": "shader",
    "shader_template": "objects\\characters\\spartans\\shaders\\spartan_armor.shader",
    "shader_bitmap_params": {
      "base": "base_map",
      "normal": "bump_map",
      "specular": "specular_map",
      "change_color": "change_color_map"
    },
    "bitmap_dir": "objects\\characters\\spartans_armory\\bitmaps",
    "role_suffix": {
      "normal": "_zbump"
    },
    "import_commands": [
      "tool.exe bitmaps \"{bitmap_dir}\"",
      "tool.exe render \"{data_dir}\""
    ],
    "hookup": [
      {
        "op": "set_reference",
        "tag": "objects\\characters\\spartans\\spartans.model",
        "field": "render model",
        "value": "{render_model_tag}"
      }
    ],
    "change_colors": {
      "bipeds": [
        "objects\\characters\\spartans\\spartans.biped"
      ],
      "channels": {
        "primary": 0,
        "secondary": 1
      }
    },
    "scenarios": [
      "levels\\solo\\m05\\m05",
      "levels\\solo\\m10\\m10",
      "levels\\solo\\m20\\m20",
      "levels\\solo\\m30\\m30",
      "levels\\solo\\m35\\m35",
      "levels\\solo\\m45\\m45",
      "levels\\solo\\m50\\m50",
      "levels\\solo\\m52\\m52",
      "levels\\solo\\m60\\m60",
      "levels\\solo\\m70\\m70",
      "levels\\solo\\m70_a\\m70_a",
      "levels\\solo\\m70_bonus\\m70_bonus"
    ],
    "build_command": "tool.exe build-cache-file {scenario}"
  },
  "_verify": "Reach's campaign normally picks armor permutations from your MCC profile. The ported model has one permutation per region, so the profile's picks fall back to it. The region names, the shader template path and whether the Reach kit imports JMS through `tool render` all need checking in HREK."
