<Project Sdk="Microsoft.NET.Sdk">
  <!--
    dotnet build -c Release
    No Editing Kit is needed to compile: ManagedBlam is loaded at runtime from the kit
    passed on the command line, so this builds on any Windows machine (and in CI).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ArmoryTool</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>
</Project>
